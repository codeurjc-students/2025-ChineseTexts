chinesereads.com, www.chinesereads.com {
    encode gzip

    # Frontend Angular (archivos estáticos)
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Sitemap dinámico de textos: las páginas /text/:id viven en la base de datos,
    # así que su sitemap lo genera el backend (SitemapController). El sitemap.xml
    # estático solo lista las rutas públicas fijas; robots.txt referencia ambos.
    # Debe vivir en la raíz del sitio (no bajo /api) porque el protocolo de
    # sitemaps limita cada sitemap a su directorio y subdirectorios.
    handle /sitemap-texts.xml {
        reverse_proxy backend:8080
    }

    # Sitemap dinámico del blog: mismo razonamiento que el de textos — los posts
    # viven en la base de datos y deben ser indexables sin redeploy.
    handle /sitemap-blog.xml {
        reverse_proxy backend:8080
    }

    # Páginas públicas con contenido dinámico (textos /text/:id, Hall of Fame
    # y blog /blog + /blog/:slug): son las únicas que se renderizan en el
    # servidor (contenedor frontend-ssr). Así Google recibe el HTML completo
    # (contenido, título y metas propios) en la primera pasada, en vez del
    # shell vacío del SPA. El resto de páginas no cambia: prerender y estáticos
    # como siempre. Los assets (*.js, *.css…) no entran aquí: los pide el
    # navegador por su ruta real y los sirve el handle estático de abajo. Los
    # paths sin * son match exacto (p. ej. /hall-of-fame/otra-cosa NO entra y
    # cae al shell SPA). /blog-editor queda FUERA a propósito: es la página
    # privada del admin (shell SPA + noindex; Quill solo corre en navegador).
    @ssrPages path /text/* /es/text/* /hall-of-fame /es/hall-of-fame /blog /es/blog /blog/* /es/blog/*
    handle @ssrPages {
        # HTML dinámico: revalidar siempre, igual que el HTML estático de abajo.
        header Cache-Control "no-cache"
        reverse_proxy frontend-ssr:4000
    }

    handle {
        root * /srv

        # Ficheros de build con hash en el nombre (main-XXXX.js, styles-XXXX.css…):
        # su nombre cambia si cambia el contenido, así que se pueden cachear "para
        # siempre" con total seguridad.
        @immutable path_regexp \-[A-Za-z0-9]{6,}\.(js|css|woff2)$
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # HTML (páginas prerenderizadas, index.html raíz y rutas del SPA): se revalida
        # SIEMPRE, para que tras un despliegue el navegador coja la versión nueva sin
        # tener que recargar a mano (evita arrastrar una página/bundle cacheado viejo).
        @html not path_regexp \.(js|css|woff2|woff|ttf|otf|png|jpe?g|gif|svg|ico|webp|json|xml|txt|map|webmanifest|wasm)$
        header @html Cache-Control "no-cache"

        # Sirve el HTML prerenderizado por ruta ({path}/index.html) antes de caer
        # al index.html raíz. Sin la parte "{path}/index.html", rutas como /texts
        # o /signup servían la home y perdían su SEO (título/meta/Open Graph propios).
        # El último fallback /index.html mantiene el enrutado SPA para rutas no
        # prerenderizadas (p. ej. /text/:id, /texts/HSK1).
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Red de seguridad del SSR: si el contenedor frontend-ssr está caído o falla
    # (502/503/504 del reverse_proxy), servir el shell del SPA como se hacía antes
    # de tener SSR — la página funciona igual para las personas (el navegador
    # ejecuta el JS) y solo se pierde temporalmente la mejora SEO. El peor caso
    # queda acotado al comportamiento pre-SSR, nunca peor.
    handle_errors {
        @ssrDown expression `{err.status_code} in [502, 503, 504]`
        handle @ssrDown {
            root * /srv
            rewrite * /index.html
            file_server
        }
    }
}

http://chinesereads.com, http://www.chinesereads.com {
    redir https://chinesereads.com{uri} permanent
}